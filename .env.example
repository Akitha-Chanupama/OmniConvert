# ==========================================
# OmniConvert Production Configuration
# ==========================================

# Server Host & Port (defaults to dynamic cloud $PORT, fallback 8000)
HOST=0.0.0.0
PORT=8000

# Application Mode: 'hosted' or 'local'
APP_MODE=hosted

# Maximum Upload File Size Limit in Megabytes (default: 50MB)
MAX_UPLOAD_SIZE_MB=50

# CORS Allowed Origins
# Use '*' or specific comma-separated URLs (e.g. https://omniconvert.yourdomain.com)
CORS_ORIGINS=*
ALLOW_ALL_ORIGINS=true

# Temporary Workspace Cleanup Timing
# Interval between automated cleanup sweeps (minutes)
CLEANUP_INTERVAL_MINUTES=15
# Maximum age before temporary conversion workspaces are deleted (minutes)
CLEANUP_MAX_AGE_MINUTES=30
